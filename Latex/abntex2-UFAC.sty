\chapter{RESULTADOS}\label{sec:resultados}

\section{Pipeline KDD e Cobertura Populacional}
\begin{itemize}
    \item Processamento automatizado de 100\% da base de dados do Portal da Transparência do Acre.
    \item Análise abrangendo mais de 429 mil registros de despesas públicas no período compreendido entre 2020 e 2025, executada através de scripts em Python.
\end{itemize}

\section{Filtro Estatístico de Benford e Z-Score (Diagnóstico de Falsos Positivos)}
\begin{itemize}
    \item Detecção de anomalias estatísticas expressivas localizadas nos Dígitos 4 ($Z = +9,97$) e 7 ($Z = +25,66$).
    \item A análise qualitativa de texto (NLP) revelou que os picos detectados não representavam fraudes mascaradas.
    \item Confirmação de que as anomalias numéricas eram, na verdade, "falsos positivos" causados por padronizações normativas, correspondendo a valores tabelados de diárias civis e militares originárias do Fundo Penitenciário.
\end{itemize}

\section{Redes de Grafos e Oligopólios Estruturais}
\begin{itemize}
    \item Mapeamento de matrizes de co-ocorrência construídas por meio das bibliotecas NetworkX e PyVis.
    \item Evidência visual e matemática de altíssima centralização de mercado na esfera pública estadual.
    \item Identificação de um núcleo isolado e reduzido de empresas que atuam simultaneamente em até 28 secretarias através do uso intensivo de Atas de Registro de Preço ("Caronas").
\end{itemize}

\section{Algoritmo de Smurfing e o Estudo de Caso 4Health}
\begin{itemize}
    \item O algoritmo de varredura desenvolvido para fracionamento identificou R\$ 12,07 milhões alocados em 9 repasses para a empresa 4Health Serviços Médicos Ltda no Fundo Estadual de Saúde (FUNDES/SESACRE).
    \item A inspeção aprofundada dos históricos contábeis (processos SEI e Contratos 677/2023 e 862/2024) revelou a prestação continuada de serviços de anestesiologia utilizando a modalidade de dispensa de licitação ao longo de 3 anos consecutivos (2023 a 2025).
\end{itemize}

\subsection{Diagnóstico Forense}
\begin{itemize}
    \item O modelo demonstrou capacidade de extrapolar a detecção do fracionamento comum de pequeno valor.
    \item Exposição analítica de um cenário de "emergência fabricada" ou inércia administrativa, respaldado pela escassez crônica de médicos anestesiologistas e pela renovação de dispensas amparada em sucessivos decretos de emergência climática no Estado do Acre.
\end{itemize}

